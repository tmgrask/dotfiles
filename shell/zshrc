# User-local commands installed by this dotfiles repository.
export PATH="$HOME/.local/bin:$HOME/go/bin:$PATH"

if [[ "$(uname -s)" == Darwin ]]; then
    if [[ -x /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -x /usr/local/bin/brew ]]; then
        eval "$(/usr/local/bin/brew shellenv)"
    fi

    export JAVA_HOME="${JAVA_HOME:-/Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home}"
    export ANDROID_HOME="${ANDROID_HOME:-$HOME/Library/Android/sdk}"
    export PATH="$ANDROID_HOME/emulator:$ANDROID_HOME/platform-tools:$PATH"
    alias nebula-up="sudo nebula -config /opt/homebrew/etc/nebula/config.yml"
    alias ls="ls -G"
else
    alias ls="ls --color=auto"
fi

if command -v fzf >/dev/null 2>&1; then
    if fzf_shell_integration=$(fzf --zsh 2>/dev/null); then
        eval "${fzf_shell_integration}"
    elif [[ -f "$HOME/.fzf.zsh" ]]; then
        source "$HOME/.fzf.zsh"
    fi
    unset fzf_shell_integration
fi
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi

# Shared key bindings.
bindkey -r '^T'
bindkey '^F' fzf-file-widget
bindkey -s '^T' 'tmux-sessionizer^M'

alias vim="nvim"
alias so="source ~/.zshrc"

# Private settings stay outside the dotfiles repository.
for private_settings in "$HOME"/.zshrc_private/*(N.); do
    source "${private_settings}"
done
unset private_settings

export NVM_DIR="$HOME/.nvm"
[[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"
[[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"

# Keep the repository-pinned Pi runtime ahead of system Node.js and optional nvm defaults.
if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate zsh)"
fi

export PATH="$HOME/flutter/bin:$HOME/.opencode/bin:$PATH"
[[ -f "$HOME/.deno/env" ]] && source "$HOME/.deno/env"

if [[ "$(uname -s)" == Darwin && -d /opt/homebrew/opt/go@1.24/bin ]]; then
    export PATH="/opt/homebrew/opt/go@1.24/bin:$PATH"
fi

[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"
# pi-web-tools websearch (Exa hosted MCP endpoint; keyless/rate-limited —
# append ?exaApiKey=YOUR_KEY for higher limits)
export PI_WEB_TOOLS_EXA_ENDPOINT="https://mcp.exa.ai/mcp"

export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$HOME/.maestro/bin:$HOME/.grok/bin:$PATH"

if [[ -d "$HOME/.grok/completions/zsh" ]]; then
    fpath=("$HOME/.grok/completions/zsh" $fpath)
fi
autoload -Uz compinit && compinit -C

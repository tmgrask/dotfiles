#!/usr/bin/env bash
set -euo pipefail

setup_url_file="${HOME}/.config/herdr/plugins/config/herdr-mobile-relay.events/tailscale-setup-url"
relay_binary="${HOME}/.local/share/herdr-mobile-relay/current/herdr-mobile-relay"

if [[ ! -r "${setup_url_file}" ]]; then
    echo "herdr-mobile-setup-qr: missing private setup URL at ${setup_url_file}" >&2
    exit 1
fi
if [[ ! -x "${relay_binary}" ]]; then
    echo "herdr-mobile-setup-qr: missing installed relay binary at ${relay_binary}" >&2
    exit 1
fi

exec "${relay_binary}" qr --columns "${COLUMNS:-80}" "$(<"${setup_url_file}")"

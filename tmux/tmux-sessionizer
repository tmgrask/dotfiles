#!/usr/bin/env bash

tmux_command=$(command -v tmux)
tmux_server_pid=$($tmux_command display-message -p '#{pid}' 2>/dev/null || true)
if [[ -n $tmux_server_pid && $(uname -s) == Darwin ]]; then
  tmux_server_command=$(lsof -a -p "$tmux_server_pid" -d txt -Fn 2>/dev/null \
    | sed -n 's/^n//p' \
    | grep '/tmux$' \
    | head -n1)
  if [[ -x $tmux_server_command ]]; then
    tmux_command=$tmux_server_command
  fi
fi

search_paths=()
for project_root in \
    "$HOME/checkout" \
    "$HOME/checkout/z-tasker" \
    "$HOME/checkout/tmgrask" \
    "$HOME/.config"; do
  [[ -d "$project_root" ]] && search_paths+=("$project_root")
done

if [[ ${#search_paths[@]} -eq 0 ]]; then
  echo "tmux-sessionizer: no project search directories exist" >&2
  exit 1
fi

fzf_margin="10%"
if [[ "$1" == "--no-margin" ]]; then
    fzf_margin="0%"
fi

selected=$(find "${search_paths[@]}" -mindepth 1 -maxdepth 1 -type d | fzf --margin "${fzf_margin}" --border=rounded --padding=1 --info=hidden)

if [[ -z $selected ]]; then
  exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep -x tmux || true)

if [[ -z ${TMUX:-} ]] && [[ -z $tmux_running ]]; then
  "$tmux_command" new-session -s "$selected_name" -c "$selected"
  exit 0
fi

if ! "$tmux_command" has-session -t=$selected_name 2> /dev/null; then
  "$tmux_command" new-session -ds "$selected_name" -c "$selected"
fi

if [[ -z ${TMUX:-} ]]; then
  "$tmux_command" attach -t "$selected_name"
else
  "$tmux_command" switch-client -t "$selected_name"
fi

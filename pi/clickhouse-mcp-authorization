#!/usr/bin/env bash
set -euo pipefail

read_clickhouse_mcp_token() {
    local stored_token

    if [[ -n "${CLICKHOUSE_MCP_TOKEN:-}" ]]; then
        printf '%s' "${CLICKHOUSE_MCP_TOKEN}"
        return
    fi

    if command -v security >/dev/null 2>&1 \
        && stored_token=$(security find-generic-password -a "${USER}" -s clickhouse-mcp-token -w 2>/dev/null); then
        printf '%s' "${stored_token}"
        return
    fi

    if command -v pass >/dev/null 2>&1 \
        && stored_token=$(pass show clickhouse-mcp-token 2>/dev/null); then
        printf '%s' "${stored_token%%$'\n'*}"
        return
    fi

    printf 'clickhouse-mcp-authorization: configure CLICKHOUSE_MCP_TOKEN, macOS Keychain service clickhouse-mcp-token, or pass entry clickhouse-mcp-token\n' >&2
    return 1
}

token=$(read_clickhouse_mcp_token)
if [[ -z "${token}" ]]; then
    printf 'clickhouse-mcp-authorization: the configured token is empty\n' >&2
    exit 1
fi

printf 'Bearer %s' "${token}"

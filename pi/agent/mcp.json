{
  "settings": {
    "autoAuth": true,
    "directTools": false,
    "hostConfigDiscovery": "off",
    "mcpFooterStatus": "compact",
    "toolResultRendering": "compact"
  },
  "mcpServers": {
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "auth": "oauth",
      "lifecycle": "lazy"
    },
    "azure": {
      "command": "dnx",
      "args": [
        "Azure.Mcp@2.0.5",
        "--source",
        "https://api.nuget.org/v3/index.json",
        "--yes",
        "--",
        "azmcp",
        "server",
        "start",
        "--read-only"
      ],
      "lifecycle": "lazy",
      "requestTimeoutMs": 120000
    },
    "clickhouse": {
      "url": "http://localhost:8000/mcp",
      "headers": {
        "Authorization": "!sh -c 'exec \"$HOME/.local/bin/clickhouse-mcp-authorization\"'"
      },
      "lifecycle": "lazy",
      "requestTimeoutMs": 60000
    },
    "elasticsearch": {
      "url": "http://localhost:7999/mcp",
      "lifecycle": "lazy",
      "requestTimeoutMs": 60000
    }
  }
}
